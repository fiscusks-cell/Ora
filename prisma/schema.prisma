generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum BillingPeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TimePeriodStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

model Organization {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  logo                 String?
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  billingPeriod        BillingPeriod @default(MONTHLY)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members     User[]
  clients     Client[]
  projects    Project[]
  timePeriods TimePeriod[]
  invites     Invite[]
  invoices    Invoice[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  avatarUrl      String?
  passwordHash   String?
  role           Role     @default(MEMBER)
  organizationId String
  connectedQBO   Boolean  @default(false)
  qboRealmId     String?
  qboTokens      String?
  connectedXero  Boolean  @default(false)
  xeroTenantId   String?
  xeroTokens     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  sessions      Session[]
  accounts      Account[]

  @@index([organizationId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  currency       String  @default("USD")
  qboCustomerId  String?
  xeroContactId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
  @@map("clients")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  color          String   @default("#3730A3")
  hourlyRate     Decimal  @default(0) @db.Decimal(10, 2)
  isBillable     Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries  TimeEntry[]

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@map("projects")
}

model TimeEntry {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  description     String?
  startedAt       DateTime
  stoppedAt       DateTime?
  durationSeconds Int?
  isBillable      Boolean   @default(true)
  timePeriodId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timePeriod TimePeriod? @relation(fields: [timePeriodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([timePeriodId])
  @@map("time_entries")
}

model TimePeriod {
  id             String           @id @default(cuid())
  organizationId String
  periodType     BillingPeriod    @default(MONTHLY)
  startDate      DateTime
  endDate        DateTime
  status         TimePeriodStatus @default(OPEN)
  approvedAt     DateTime?
  approvedBy     String?
  publishedAt    DateTime?
  qboInvoiceId   String?
  xeroInvoiceId  String?
  reportPdfUrl   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      TimeEntry[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("time_periods")
}

model Invite {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  role           Role     @default(MEMBER)
  token          String   @unique @default(cuid())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  periodId       String?
  invoiceNumber  String
  clientName     String
  amount         Float
  currency       String   @default("USD")
  pdfData        Bytes?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period       TimePeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("invoices")
}
